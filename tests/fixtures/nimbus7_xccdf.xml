<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.1" id="NIMBUS7_RELAY_STIG">
  <title>Nimbus7 Relay Security Technical Implementation Guide</title>
  <version>1</version>
  <plain-text id="release-info">Release: 1 Benchmark Date: 24 Jul 2024</plain-text>
  <Group id="V-940001">
    <Rule id="SV-940001r1_rule" severity="medium">
      <title>Nimbus7 Relay must log administrative access.</title>
      <description>&lt;VulnDiscussion&gt;Unlogged administration cannot be reviewed.&lt;/VulnDiscussion&gt;</description>
      <fixtext>Enable administrative logging.</fixtext>
      <check><check-content>Verify administrative logging is enabled.</check-content></check>
      <ident system="http://iase.disa.mil/cci">CCI-000015</ident>
    </Rule>
  </Group>
