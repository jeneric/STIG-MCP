<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.1" id="ZZCONTAINER_PLATFORM_4-9_STIG">
  <status date="2024-12-06">accepted</status>
  <title>Zzcontainer Platform 4-9 Security Technical Implementation Guide</title>
  <version>2</version>
  <plain-text id="release-info">Release: 2 Benchmark Date: 06 Dec 2024</plain-text>
  <Group id="V-950101">
    <Rule id="SV-950101r1_rule" severity="high">
      <title>Zzcontainer Platform must authenticate every request.</title>
      <description>&lt;VulnDiscussion&gt;Shared with the successor benchmark.&lt;/VulnDiscussion&gt;</description>
      <fixtext>Enable request authentication.</fixtext>
      <check><check-content>Verify request authentication is enabled.</check-content></check>
      <ident system="http://iase.disa.mil/cci">CCI-000015</ident>
    </Rule>
  </Group>
  <Group id="V-950102">
    <Rule id="SV-950102r1_rule" severity="medium">
      <title>Zzcontainer Platform must log every denial.</title>
      <description>&lt;VulnDiscussion&gt;Shared with the successor benchmark.&lt;/VulnDiscussion&gt;</description>
      <fixtext>Enable denial logging.</fixtext>
      <check><check-content>Verify denial logging is enabled.</check-content></check>
      <ident system="http://iase.disa.mil/cci">CCI-000015</ident>
    </Rule>
  </Group>
  <Group id="V-950132">
    <Rule id="SV-950132r1_rule" severity="low">
      <title>Zzcontainer Platform 4-9 must retire its legacy shim.</title>
      <description>&lt;VulnDiscussion&gt;Present only in the older benchmark.&lt;/VulnDiscussion&gt;</description>
      <fixtext>Remove the legacy shim.</fixtext>
      <check><check-content>Verify the legacy shim is absent.</check-content></check>
      <ident system="http://iase.disa.mil/cci">CCI-000015</ident>
    </Rule>
  </Group>
</Benchmark>
